{
  "name": "life-kline",
  "version": "0.1.0",
  "private": true,
  "description": "Draw a whole life as a stock K-line chart: a Remotion video template in an ink-wash, old-paper style.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "sfx": "node scripts/sfx.mjs",
    "render": "remotion render src/index.ts LifeKline out/life-kline.mp4",
    "cover": "remotion still src/index.ts Cover out/cover.png",
    "typecheck": "tsc -p . --noUnusedLocals"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
